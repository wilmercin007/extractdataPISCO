        "ax.legend(loc='upper right', fontsize=10)\n",
        "ax.grid(True, which='both', linestyle='--', linewidth=0.7, alpha=0.7)\n",
        "\n",
        "# Invertimos el eje Y para que las profundidades se vean hacia abajo\n",
        "ax.invert_yaxis()\n",
        "\n",
        "# Mostrar el gráfico\n",
        "plt.tight_layout()\n",
        "plt.show()"

        "# Importamos las librerías necesarias\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Cargar archivos de Excel\n",
        "df_sismos = pd.read_excel('SISMOS.xlsx')\n",
        "df_terreno = pd.read_excel('TERRENO.xlsx')\n",
        "\n",
        "# Paleta de colores para PROF_CAT (Categoría de profundidad)\n",
        "colors = {\n",
        "    'Superficial': 'red',       # Rojo\n",
        "    'Intermedio': 'lightgreen'  # Verde claro\n",
        "}\n",
        "\n",
        "# Crear el gráfico\n",
        "fig, ax = plt.subplots(figsize=(10, 6))\n",
        "\n",
        "# Graficamos el perfil del terreno (invertido, color marrón)\n",
        "ax.plot(df_terreno['DIST_REL2'], -df_terreno['ALTITUD_KM'], color='black', label='Perfil del Terreno')\n",
        "\n",
        "# Graficamos los sismos con colores dependiendo de la categoría de profundidad\n",
        "for cat, color in colors.items():\n",
        "    subset = df_sismos[df_sismos['PROF_CAT'] == cat]\n",
        "    sizes = (subset['MAGNITUD'] - df_sismos['MAGNITUD'].min()) * 40  # Escalar tamaños de acuerdo a la magnitud\n",
        "    ax.scatter(subset['DIST_REL'], -subset['ALTITUD'], color=color, label=f'Sismos {cat}',\n",
        "               s=sizes, edgecolor='black', alpha=0.6)\n",
        "\n",
        "# Estilo del gráfico\n",
        "ax.set_xlabel('Distancia Relativa al Eje A-A (km)', fontsize=12)\n",

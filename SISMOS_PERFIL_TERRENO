      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Cargar los datos del archivo de terreno y sismos\n",
        "terreno = pd.read_excel('TERRENO.xlsx')\n",
        "df_sismos = pd.read_excel('SISMOS.xlsx')\n",
        "\n",
        "# Crear gráficos paralelos\n",
        "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8), gridspec_kw={'height_ratios': [1, 2]})\n",
        "\n",
        "# Gráfico del perfil del terreno (ax1) - Exagerando altitud y ajustando valores positivos\n",
        "ax1.plot(terreno['DIST_REL2'], abs(terreno['ALTITUD_KM']), color='brown', label='Perfil del Terreno', linewidth=2)\n",
        "ax1.set_title(\"Perfil del Terreno (Altitud exagerada)\")\n",
        "ax1.set_xlabel(\"Distancia (km)\")\n",
        "ax1.set_ylabel(\"Altitud (m)\")\n",
        "ax1.fill_between(terreno['DIST_REL2'], abs(terreno['ALTITUD_KM']), color=\"tan\", alpha=0.5)\n",
        "\n",
        "# Exagerar el eje de altitud para resaltar la topografía\n",
        "ax1.set_ylim(0, abs(terreno['ALTITUD_KM'].max()) * 1.5)\n",
        "ax1.grid(True)\n",
        "\n",
        "# Igualar el rango del eje X en ambos gráficos\n",
        "x_min, x_max = ax1.get_xlim()  # Obtener los límites del eje X basados en el gráfico del terreno\n",
        "\n",
        "# Gráfico de los sismos (ax2)\n",
        "# Colores para superficial (rojo) e intermedio (verde claro), tamaños y transparencia\n",
        "colors = ['red' if prof == 'Superficial' else 'lightgreen' for prof in df_sismos['PROF_CAT']]\n",
        "sizes = df_sismos['MAGNITUD'] * 20  # Aumentar el tamaño según magnitud\n",
        "scatter = ax2.scatter(df_sismos['DIST_REL'], -df_sismos['ALTITUD'], s=sizes, c=colors, alpha=0.6, edgecolors='black')\n",
        "\n",
        "# Configuración de ejes y etiquetas\n",
        "ax2.set_title(\"Distribución de Sismos (Superficial: Rojo, Intermedio: Verde Claro)\")\n",
        "ax2.set_xlabel(\"Distancia (km)\")\n",
        "ax2.set_ylabel(\"Profundidad (km)\")\n",
        "ax2.invert_yaxis()  # Invertir el eje Y para que el 0 esté arriba y la profundidad descienda\n",
        "ax2.grid(True)\n",
        "\n",
        "# Ajustar los límites del eje X para que coincidan con los del gráfico del terreno\n",
        "ax2.set_xlim(x_min, x_max)\n",
        "\n",
        "# Crear manualmente una leyenda de magnitudes con rangos\n",
        "magnitudes = [3.5, 4.5, 5.5, 6.5]  # Rango de magnitudes para la leyenda\n",
        "sizes_legend = [mag * 20 for mag in magnitudes]  # Tamaño de los círculos para la leyenda\n",
        "labels_legend = [f'{mag} - {mag+1}' for mag in magnitudes]  # Etiquetas de los rangos\n",
        "\n",
        "# Agregar los círculos de ejemplo a la leyenda\n",
        "for size, label in zip(sizes_legend, labels_legend):\n",
        "    ax2.scatter([], [], s=size, c='gray', alpha=0.6, edgecolors='black', label=f'Magnitud: {label}')\n",
        "\n",
        "# Mostrar la leyenda\n",
        "ax2.legend(loc='upper right', fontsize=10, title='Rango de Magnitudes')\n",
        "\n",
        "# Mostrar el gráfico final\n",
        "plt.tight_layout()\n",
        "plt.show()"
